---
interface Props {
  title: string;
  description: string;
  keywords?: string | string[];
  canonicalUrl?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogImageAlt?: string;
  twitterSite?: string;
}

const {
  title,
  description,
  keywords,
  canonicalUrl,
  ogTitle,
  ogDescription,
  ogImage = "/images/og.jpg",
  ogImageAlt =
    "Estudiantes internacionales viviendo una experiencia academica global con We Are TOP",
  twitterSite,
} = Astro.props;

const siteUrl = "https://www.wearetop.co";
const canonical = canonicalUrl ?? new URL(Astro.url.pathname, siteUrl).toString();
const socialImageUrl = new URL(ogImage, siteUrl).toString();
const pageKeywords = Array.isArray(keywords) ? keywords.join(", ") : keywords;
const socialTitle = ogTitle ?? title;
const socialDescription = ogDescription ?? description;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: title,
  description,
  url: canonical,
  inLanguage: "es-CO",
  isPartOf: {
    "@type": "WebSite",
    name: "We Are TOP",
    url: siteUrl,
  },
};
---

<link rel="icon" href="/images/32x32.png" sizes="32x32" />
<meta name="description" content={description} />
{pageKeywords && <meta name="keywords" content={pageKeywords} />}
<meta name="robots" content="index,follow" />
<meta name="theme-color" content="#0E2A47" />
<link rel="canonical" href={canonical} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:locale" content="es_CO" />
<meta property="og:site_name" content="We Are TOP" />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={socialTitle} />
<meta property="og:description" content={socialDescription} />
<meta property="og:image" content={socialImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogImageAlt} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonical} />
<meta name="twitter:title" content={socialTitle} />
<meta name="twitter:description" content={socialDescription} />
<meta name="twitter:image" content={socialImageUrl} />
<meta name="twitter:image:alt" content={ogImageAlt} />
{twitterSite && <meta name="twitter:site" content={twitterSite} />}

<script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
