---
import IlscLogo from "@/icons/logos/ilsc.svg";
---

<section
  class="bg-cgray-100 flex flex-col justify-center gap-6 p-4 py-12 md:py-24"
>
  <ul
    class:list={[
      "item-center flex list-none flex-wrap items-center justify-center gap-x-8 gap-y-3 p-0 md:gap-x-12 md:gap-y-4",
    ]}
  >
    <li>
      <IlscLogo
        aria-label="ILSC Logo"
        width={80}
        height={30}
        class="h-10 w-auto"
      />
    </li>
    <li>
      <img
        src="/images/logos/bayswater.png"
        alt="Bayswater Logo"
        width={80}
        height={30}
        class="h-7 w-auto"
      />
    </li>
    <li>
      <img
        src="/images/logos/bli.png"
        alt="Bli Logo"
        width={80}
        height={80}
        class="h-16 w-auto"
      />
    </li>
    <li>
      <img
        src="/images/logos/ilac.webp"
        alt="ILAC Logo"
        width={80}
        height={30}
        class="h-7 w-auto invert"
      />
    </li>
  </ul>
</section>
