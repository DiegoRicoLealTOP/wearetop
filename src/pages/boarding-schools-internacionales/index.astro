---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/boarding-school-internationals/hero.astro";
import ScrollDrivenAnimation from "@/components/boarding-school-internationals/scroll-driven-animation.astro";
import Schools from "@/components/boarding-school-internationals/schools.astro";
import Testimonials from "@/components/home/testimonials.astro";
---

<Layout
  title="Boarding Schools internacionales | Educacion secundaria en el exterior"
  description="Estudia en boarding schools internacionales con formacion academica de alto nivel, entorno seguro y proyeccion global desde edades tempranas."
  keywords={[
    "boarding schools internacionales",
    "estudiar secundaria en el exterior",
    "colegios internacionales internado",
    "educacion secundaria en el extranjero",
    "high school en el exterior",
  ]}
  canonicalUrl="https://www.wearetop.co/boarding-schools-internacionales/"
  ogTitle="Boarding Schools internacionales | We Are TOP"
  ogDescription="Educacion secundaria internacional en colegios de alto nivel con acompanamiento experto."
  ogImage="/images/og.jpg"
  ogImageAlt="Estudiantes de secundaria en un boarding school internacional con We Are TOP"
>
  <Hero />
  <ScrollDrivenAnimation />
  <Schools />
  <Testimonials />
</Layout>
