---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/home/hero.astro";
import ScrollDrivenAnimation from "@/components/home/scroll-driven-animation.astro";
import Bento from "@/components/home/bento.astro";
import Testimonials from "@/components/home/testimonials.astro";
---

<Layout
  title="Estudia en el exterior | Idiomas, universidades y asesoria internacional"
  description="Estudia en el exterior con asesoria experta. Idiomas, universidades, boarding schools y destinos globales con acompanamiento personalizado."
  keywords={[
    "estudiar en el exterior",
    "estudiar en el extranjero",
    "asesoria estudios internacionales",
    "agencias para estudiar en el exterior",
    "programas internacionales estudiantes",
    "educacion internacional",
  ]}
  canonicalUrl="https://www.wearetop.co/"
  ogTitle="Estudia en el exterior con We Are TOP"
  ogDescription="Programas internacionales, idiomas y universidades con asesoria personalizada y enfoque estrategico."
  ogImage="/images/og.jpg"
  ogImageAlt="Estudiantes internacionales viviendo una experiencia academica global con We Are TOP"
>
  <Hero />
  <ScrollDrivenAnimation />
  <Bento />
  <Testimonials />
</Layout>
