---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/idiomas/hero.astro";
import ScrollDrivenAnimation from "@/components/idiomas/scroll-driven-animation.astro";
import Destinations from "@/components/idiomas/destinations.astro";
import Contact from "@/components/idiomas/contact.astro";
import Testimonials from "@/components/home/testimonials.astro";
---

<Layout
  title="Estudia idiomas en el exterior | Ingles, frances y mas"
  description="Estudia idiomas en el exterior con programas en destinos como Canada, Australia, Irlanda y mas. Aprende y trabaja mientras vives una experiencia global."
  keywords={[
    "estudiar idiomas en el exterior",
    "cursos de idiomas en el extranjero",
    "estudiar ingles en el exterior",
    "estudiar y trabajar en el extranjero",
    "cursos de ingles internacionales",
  ]}
  canonicalUrl="https://www.wearetop.co/idiomas/"
  ogTitle="Estudia idiomas en el exterior | We Are TOP"
  ogDescription="Programas de idiomas en destinos globales con asesoria experta y opciones de trabajo."
  ogImage="/images/og.jpg"
  ogImageAlt="Estudiantes aprendiendo idiomas en destinos internacionales con We Are TOP"
>
  <Hero />
  <ScrollDrivenAnimation />
  <Destinations />
  <Contact />
  <Testimonials />
</Layout>
