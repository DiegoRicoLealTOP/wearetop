---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/universidades/hero.astro";
import ScrollDrivenAnimation from "@/components/universidades/scroll-driven-animation.astro";
import Universities from "@/components/universidades/universities.astro";
import Testimonials from "@/components/home/testimonials.astro";
---

<Layout
  title="Estudia en universidades en el exterior | Pregrados y posgrados"
  description="Accede a universidades internacionales con programas de pregrado y posgrado. Asesoria estrategica para construir tu futuro academico global."
  keywords={[
    "estudiar en universidades en el exterior",
    "pregrado en el extranjero",
    "posgrados en el exterior",
    "universidades internacionales",
    "estudiar en el extranjero universidades",
    "asesoria universitaria internacional",
  ]}
  canonicalUrl="https://www.wearetop.co/universidades/"
  ogTitle="Universidades en el exterior | We Are TOP"
  ogDescription="Programas internacionales de pregrado y posgrado con asesoria personalizada."
  ogImage="/images/og.jpg"
  ogImageAlt="Estudiantes en campus universitario internacional con We Are TOP"
>
  <Hero />
  <ScrollDrivenAnimation />
  <Universities />
  <Testimonials />
</Layout>
