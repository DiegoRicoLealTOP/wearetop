---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/higher-education/hero.astro";
import Info from "@/components/higher-education/info.astro";
import CountDown from "@/components/higher-education/countdown.astro";
import Bento from "@/components/higher-education/bento.astro";
import ScrollDrivenAnimation from "@/components/higher-education/scroll-driven-animation.astro";
import Pricing from "@/components/higher-education/pricing.astro";
import Contact from "@/components/higher-education/contact.svelte";
---

<Layout
  title="ICMS Sydney | Estudia en International College of Management Sydney"
  description="Estudia en ICMS Sydney, una de las instituciones lideres en management, hospitality y negocios en Australia con enfoque practico e internacional."
  keywords={[
    "ICMS Sydney",
    "International College of Management Sydney",
    "estudiar en ICMS Australia",
    "universidades en Sydney Australia",
    "hospitality management Australia",
  ]}
  canonicalUrl="https://www.wearetop.co/universidades/icms-sydney/"
  ogTitle="ICMS Sydney | Estudia en Australia"
  ogDescription="Programas internacionales en ICMS con acompanamiento experto."
  ogImage="/images/og.jpg"
  ogImageAlt="Campus de ICMS Sydney para programas internacionales con We Are TOP"
>
  <Hero />
  <ScrollDrivenAnimation />
  <CountDown />
  <Pricing />
  <Bento />
  <Info />
  <Contact client:visible />
</Layout>
