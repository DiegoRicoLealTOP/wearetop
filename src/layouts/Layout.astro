---
import "@fontsource/lato/100.css";
import "@fontsource/lato/300.css";
import "@fontsource/lato/400.css";
import "@fontsource/lato/700.css";
import "@fontsource/lato/900.css";

import Head from "@/components/head.astro";
import BodyMetaTags from "@/components/body-meta-tags.astro";
import TopBar from "@/components/top-bar.astro";
import Footer from "@/components/footer.astro";
import Globals from "@/components/globals.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  keywords?: string | string[];
  canonicalUrl?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogImageAlt?: string;
  twitterSite?: string;
}

const {
  title,
  description = "Estudia en el exterior con asesoria experta. Idiomas, universidades, boarding schools y destinos globales con acompanamiento personalizado.",
  keywords,
  canonicalUrl,
  ogTitle,
  ogDescription,
  ogImage = "/images/og.jpg",
  ogImageAlt,
  twitterSite,
} = Astro.props;
---

<!doctype html>
<html lang="es" class="overflow-x-hidden scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <Head
      title={title}
      description={description}
      keywords={keywords}
      canonicalUrl={canonicalUrl}
      ogTitle={ogTitle}
      ogDescription={ogDescription}
      ogImage={ogImage}
      ogImageAlt={ogImageAlt}
      twitterSite={twitterSite}
    />
  </head>
  <body class="overflow-x-hidden">
    <BodyMetaTags />
    <TopBar />
    <slot />
    <Globals />
    <Footer />
  </body>
</html>

<style>
  html,
  body {
    scroll-padding-top: 64px;
  }

  body {
    font-family:
      "Lato",
      system-ui,
      -apple-system,
      "Segoe UI",
      Roboto,
      "Helvetica Neue",
      sans-serif;
  }
</style>
